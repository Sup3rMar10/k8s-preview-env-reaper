# One preview environment per pull request. Rendered by scripts/preview.sh with envsubst:
#   ${PR}       pull request number
#   ${EXPIRES}  expiry time as epoch seconds
apiVersion: v1
kind: Namespace
metadata:
  name: pr-${PR}
  labels:
    preview: "true"
    preview-pr: "${PR}"
    # Previews run untrusted branch code, so hold them to the strictest Pod Security level.
    pod-security.kubernetes.io/enforce: restricted
  annotations:
    # The reaper deletes the namespace once this time has passed.
    preview-expires-at: "${EXPIRES}"
---
# A runaway or malicious branch must not be able to starve the cluster.
apiVersion: v1
kind: ResourceQuota
metadata:
  name: preview-quota
  namespace: pr-${PR}
spec:
  hard:
    pods: "6"
    requests.cpu: 500m
    requests.memory: 512Mi
    limits.memory: 512Mi
    services: "5"
    persistentvolumeclaims: "0"
---
apiVersion: v1
kind: LimitRange
metadata:
  name: preview-defaults
  namespace: pr-${PR}
spec:
  limits:
    - type: Container
      defaultRequest:
        cpu: 25m
        memory: 32Mi
      default:
        memory: 64Mi
---
# Default deny for inbound traffic, then allow only pods in the same namespace.
# (Enforcement depends on the cluster's network plugin; see the README.)
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: same-namespace-only
  namespace: pr-${PR}
spec:
  podSelector: {}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector: {}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app
  namespace: pr-${PR}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: app
  template:
    metadata:
      labels:
        app: app
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          image: nginxinc/nginx-unprivileged:1.27-alpine
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /
              port: http
            periodSeconds: 2
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
---
apiVersion: v1
kind: Service
metadata:
  name: app
  namespace: pr-${PR}
spec:
  selector:
    app: app
  ports:
    - name: http
      port: 80
      targetPort: http
